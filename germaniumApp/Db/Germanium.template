# Database template for Germanium detector (ZMQ version)
# Macro: P - PV prefix, R - Record prefix, PORT - asyn port name, ADDR - asyn address

# =====================================================================
# Basic detector information
# =====================================================================

record(ai, "$(P)$(R)NumElements") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))GERMANIUM_NELM")
    field(SCAN, "I/O Intr")
    field(DESC, "Number of detector elements")
}

record(ai, "$(P)$(R)NumChips") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))GERMANIUM_NCHIPS")
    field(SCAN, "I/O Intr")
    field(DESC, "Number of MARS chips")
}

# =====================================================================
# IP address configuration
# =====================================================================

record(stringout, "$(P)$(R)IPAddress") {
    field(DTYP, "asynOctetWrite")
    field(OUT,  "@asyn($(PORT),$(ADDR))GERMANIUM_IPADDR")
    field(DESC, "Detector IP address")
}

record(stringin, "$(P)$(R)IPAddress_RBV") {
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR))GERMANIUM_IPADDR_RBV")
