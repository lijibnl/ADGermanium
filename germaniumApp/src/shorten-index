#!/bin/bash
set -euo pipefail

# Usage check
if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <list_file>"
  exit 1
fi

LIST_FILE="$1"

if [[ ! -f "$LIST_FILE" ]]; then
  echo "Error: File '$LIST_FILE' not found."
  exit 1
fi

while IFS= read -r line || [[ -n "$line" ]]; do
  # Trim CR from Windows endings and skip empty lines
  line="${line%$'\r'}"
  [[ -z "$line" ]] && continue

  # Derive replacement (strip leading "Germanium")
  replacement="${line#Germanium}"

  # Update all regular files in the current directory (non-recursive)
  for f in *; do
    [[ -f "$f" ]] || continue
    [[ "$f" == "$LIST_FILE" || "$f" == "$0" ]] && continue

    # Replace only when followed by space, comma, or semicolon
    perl -pi -e 's/\Q'"$line"'\E(?=[ ,;])/'"$replacement"'/g' "$f"
  done
done < "$LIST_FILE"

